# =====================================================================
# Required
# =====================================================================
cluster_name = "eks-demo-1"
aws_region   = "us-west-2"
vpc_id       = "vpc-xxxxxxxxxxxxxxxxx"

# IMPORTANT: each subnet must be in a DIFFERENT availability zone.
# VPC Interface Endpoints reject duplicate AZs (DuplicateSubnetsInSameZone)
# — listing two subnets from the same AZ here makes all 13 endpoints fail
# with one confusing error each. If you have a dedicated GPU subnet that
# happens to share an AZ with a system subnet, don't list both here; pass
# the GPU subnet via gpu_nodegroups[].subnet_ids instead.
private_subnet_ids = [
  "subnet-aaaaaaaaaaaaaaaaa", # AZ-a (system / control plane / default workers)
  "subnet-bbbbbbbbbbbbbbbbb", # AZ-b
  "subnet-ccccccccccccccccc", # AZ-c
]

public_subnet_ids = [
  "subnet-pppppppppppppppppp",
  "subnet-qqqqqqqqqqqqqqqqqq",
  "subnet-rrrrrrrrrrrrrrrrrr",
]

# =====================================================================
# Cluster mode
# =====================================================================
cluster_mode               = "private"
# public_access_cidrs        = ["0.0.0.0/0"]
k8s_version                = "1.35"
service_ipv4_cidr          = "172.20.0.0/16"
# kms_key_arn                = "arn:aws:kms:us-west-2:123456789012:key/xxxx"
enable_deletion_protection = true

vpc_endpoints_mode = "full"  # or "minimal"

# =====================================================================
# Node management mode (cluster-wide, applies to both system + GPU NGs)
# =====================================================================
# This example defaults to "self_managed" (set below). The underlying
# Terraform variable default is still "managed" — EKS Managed Node Groups,
# EKS owns the underlying ASG including self-healing (terminate + replace
# unhealthy → instance ID changes), AZ rebalancing, rolling updates. To use
# that standard upstream behavior, set node_management = "managed" below.
#
# "self_managed" mode is for when you need stable instance IDs and manual
# lifecycle control (e.g. customer CMDB tracks instances by ID, ops team
# wants to pick which exact instance to retire). In that mode:
#   - ASG self-healing is fully OFF (suspended_processes =
#     [ReplaceUnhealthy, AZRebalance], no instance_refresh)
#   - You retire instances by id:
#       aws autoscaling terminate-instance-in-auto-scaling-group \
#         --instance-id <id> --should-decrement-desired-capacity
#   - You take ownership of K8s upgrades (cordon/drain/terminate flow).
#   - cluster-autoscaler is REQUIRED for elastic scaling — keep
#     install_cluster_autoscaler = true (this stack installs ours), or
#     flip to false and bring your own CA. ASG CA-discovery tags are
#     present in either mode.
#
# Mixing modes inside one cluster is intentionally not supported.
# See docs/SELF_MANAGED_NG.md for the full design + runbook.
node_management = "self_managed"
# asg_suspended_processes = ["ReplaceUnhealthy", "AZRebalance"]   # only used in self_managed (this is the default)
# extra_asg_tags = { Owner = "ml-platform", CostCenter = "1234" } # only used in self_managed

# =====================================================================
# Cluster Autoscaler installation
# =====================================================================
# Default = true: install our CA via Pod Identity, image + chart auto-
# aligned to k8s_version. Set false to skip — the ASG discovery tags are
# inlined regardless, so an external/customer-supplied CA can pick up
# the same ASGs zero-config.
# install_cluster_autoscaler = true
# cluster_autoscaler_version       = ""    # empty = auto from k8s_version → CA matrix
# cluster_autoscaler_chart_version = ""    # empty = auto from k8s_version → chart matrix

# AWS Load Balancer Controller IAM policy source. "http" (default) fetches
# the upstream policy for alb_controller_app_version from GitHub; "file" uses
# the bundled copy in assets/iam/alb-controller/<version>/ (air-gapped, or
# GitHub.com blocked — e.g. China regions). Both pick the partition variant
# (aws / aws-cn / aws-us-gov / aws-iso / aws-iso-b) automatically.
# alb_controller_iam_policy_source = "file"

# Pod Identity associations are eventually consistent. Pods admitted right
# after an association is created can miss the credential env and fall back
# to the node role (AccessDenied — cluster-autoscaler then CrashLoops). Every
# Pod Identity consumer (CA, ALB controller, CSI controllers, Karpenter)
# waits this long after its association is created/replaced; steady-state
# applies don't wait. "0s" disables.
# pod_identity_propagation_wait = "30s"

# =====================================================================
# Cluster API access (private clusters only — leave empty for public)
# =====================================================================
# Same-VPC bastions / CI runners → reference by SG (preferred):
# extra_api_ingress_security_group_ids = ["sg-xxxxxxxxxxxxxxxxx"]
#
# DX / VPN / peered VPCs / TGW callers → reference by CIDR:
# extra_api_ingress_cidrs = ["10.100.0.0/16"]
#
# Both can be set together. Empty default = only cluster SG members reach API.

# =====================================================================
# IRSA opt-in (default off — this stack uses Pod Identity)
# =====================================================================
# Default false matches the bash flow (`withOIDC: false`) and the rest of
# this stack — Karpenter / CA / ALB / every CSI driver use Pod Identity.
# Enable only if external workloads need to verify cluster JWTs (GitHub
# Actions OIDC federation, etc). PRIVATE-CLUSTER WARNING: the eks VPC
# endpoint's private hosted zone shadows oidc.eks.<region>.amazonaws.com,
# so opt-in callers must arrange DNS for that subdomain manually.
# enable_irsa = false

# =====================================================================
# Extra cluster admins (for non-creator IAM roles)
# =====================================================================
# bootstrap_cluster_creator_admin_permissions=true automatically grants
# admin to whoever runs `terraform apply`. List here only OTHER principals
# that need cluster-admin RBAC — typical case: dev host applies, bastion
# operates day-2. NEVER list the apply-time identity (it already has admin
# and the access entry creation will collide with ResourceInUseException).
# extra_cluster_admin_role_arns = ["arn:aws:iam::123456789012:role/eks-bastion-role"]

# =====================================================================
# System nodegroup
# =====================================================================
system_node_instance_type    = "m8g.xlarge"
system_node_root_volume_size = 50
system_node_data_volume_size = 100
system_node_desired_capacity = 3
system_node_min_size         = 3
system_node_max_size         = 6

# =====================================================================
# Optional CSI drivers
# =====================================================================
install_efs_csi    = false
install_fsx_csi    = false
install_s3_csi     = false
s3_csi_bucket_arns = []

# =====================================================================
# Optional Karpenter
# =====================================================================
install_karpenter = false
# karpenter_ssh_public_key = "ssh-rsa AAAA..."

# =====================================================================
# Optional GPU nodegroups
#
# Each entry produces one EKS managed node group + Launch Template +
# (optional) Placement Group. Replace the bash DEPLOY_GPU_OD/SPOT/ODCR/CB
# toggles with explicit declarations.
#
# purchase_option ∈ { od, spot, odcr, cb }
# placement_group ∈ { none, cluster }     # cluster requires a single AZ
# capacity_reservation_id is required for odcr / cb
# =====================================================================
install_gpu_nodegroups = false

# Pin a verified AWS EKS-NVIDIA AMI release (see docs/AMI_VERSIONS.md):
# gpu_ami_release_version = "v20260512"
#
# Or override with a custom AMI baked from the EKS-NVIDIA base (corporate
# certs / monitoring agents / preloaded images / compliance). Mutually
# exclusive with gpu_ami_release_version. Custom AMI MUST derive from
# amazon-eks-node-al2023-*-nvidia-*; building from plain AL2023 unsupported.
# gpu_custom_ami_id = "ami-0123456789abcdef0"
#
# AWS Trainium / Inferentia (trn*/inf*) entries in gpu_nodegroups are
# auto-detected as Neuron and use the x86_64 EKS AL2023 Neuron AMI instead
# (gpu_custom_ami_id applies to NVIDIA only; gpu_ami_release_version is
# also inherited by Neuron unless neuron_ami_release_version is set).
# null = inherit gpu_ami_release_version (same release tags); "" = SSM
# recommended; or pin e.g. "v20261031".
# neuron_ami_release_version = null
# Custom AMI derived from amazon-eks-node-al2023-x86_64-neuron-*:
# neuron_custom_ami_id = ""

gpu_nodegroups = [
  # On-Demand p5 across all private subnets
  # {
  #   gpu_type        = "p5.48xlarge"
  #   purchase_option = "od"
  # },

  # Spot p5en, narrowed to AZ c
  # {
  #   gpu_type        = "p5en.48xlarge"
  #   purchase_option = "spot"
  #   subnet_ids      = ["subnet-ccccccccccccccccc"]
  # },

  # ODCR p6-b200 in az3 with cluster placement group
  # {
  #   gpu_type                = "p6-b200.48xlarge"
  #   purchase_option         = "odcr"
  #   suffix                  = "-1"
  #   subnet_ids              = ["subnet-ccccccccccccccccc"]
  #   capacity_reservation_id = "cr-xxxxxxxxxxxxxxxxx"
  #   placement_group         = "cluster"
  # },

  # Capacity Block p5
  # {
  #   gpu_type                = "p5.48xlarge"
  #   purchase_option         = "cb"
  #   subnet_ids              = ["subnet-ccccccccccccccccc"]
  #   capacity_reservation_id = "cr-yyyyyyyyyyyyyyyyy"
  # },

  # p5 with containerd on Instance Store NVMe (nodeadm localStorage RAID0)
  # instead of a gp3 data volume. Requires gpu_enable_local_lvm = false.
  # {
  #   gpu_type           = "p5.48xlarge"
  #   purchase_option    = "od"
  #   suffix             = "-nvme"
  #   containerd_storage = "instance_store"
  # },

  # AWS Trainium2 (auto-detected as Neuron: workload-type=neuron label,
  # aws.amazon.com/neuron taint, Neuron AMI, 16 EFA NICs). trn2.48xlarge is
  # offered in a few regions only (e.g. us-east-2, ap-south-2; NOT us-east-1)
  # — check with `aws ec2 describe-instance-type-offerings --location-type
  # region --filters Name=instance-type,Values=trn2.48xlarge` — and is usually
  # bought as Capacity Blocks. NO placement_group on cb entries: EC2 rejects
  # placement groups for Capacity Blocks (CB instances are already
  # UltraCluster co-located). Pair with install_neuron_stack = true below.
  # { gpu_type = "trn2.48xlarge", purchase_option = "cb", capacity_reservation_id = "cr-xxxx", subnet_ids = ["subnet-az1"] }  # Trainium2, Capacity Block; auto-detected as Neuron
]

# Karpenter GPU NodePools (needs install_karpenter = true). One pool per
# instance type; spot interruptions handled by Karpenter's interruption queue.
# karpenter_gpu_nodepools = [
#   {
#     name           = "p6-b300-spot"
#     instance_type  = "p6-b300.48xlarge"
#     capacity_types = ["spot"]
#     zones          = ["ap-south-2c"]
#     max_nodes      = 1
#     # instance_store_policy = "RAID0"   # default; "" = containerd on root EBS
#     # consolidate_after     = "1h"      # empty-node removal; "Never" to keep
#   },
#   # Neuron pools (trn*/inf*, auto-detected by name): workload-type=neuron,
#   # aws.amazon.com/neuron taint + device limit, Neuron AMI, EFA boothook only.
#   # Neuron pools: set install_neuron_stack = true; need karpenter_version >= 1.11
#   # for EFA types (trn1.32xlarge / trn1n / trn2), >= 1.1 otherwise (conservative
#   # minimum: NeuronInfo-based device counts + aws.amazon.com/neuroncore since v1.1).
#   # trn2 is rarely offered as Spot. Request aws.amazon.com/neuron in pods, not
#   # neuroncore (on trn2 Karpenter assumes devices x 8 cores, the plugin advertises
#   # devices x 4 at LNC=2: trn2.48xlarge 128 vs 64, trn2.3xlarge 8 vs 4).
#   # { name = "trn2-od", instance_type = "trn2.48xlarge", capacity_types = ["on-demand"], max_nodes = 1 },
#   # { name = "inf2", instance_type = "inf2.48xlarge", capacity_types = ["on-demand"], instance_store_policy = "" },  # inf1/inf2: no Instance Store
# ]
# NVIDIA pool AMI override ("" = gpu_custom_ami_id > al2023@<gpu_ami_release_version> > al2023@latest):
# karpenter_gpu_ami_selector = ""
# Neuron pool AMI override. "" = neuron_custom_ami_id > al2023@<neuron_ami_release_version>
# when non-null ("" = latest) > karpenter_gpu_ami_selector if it is an al2023@ alias >
# al2023@<gpu_ami_release_version> > al2023@latest. NVIDIA ami- ids are never inherited.
# karpenter_neuron_ami_selector = ""

# Default containerd backing store for GPU nodegroups that don't set
# containerd_storage: "ebs" (gp3 data volume + LVM) or "instance_store"
# (nodeadm localStorage RAID0 over all NVMe; ephemeral; no data volume;
# mutually exclusive with gpu_enable_local_lvm). See terraform/README.md.
# gpu_containerd_storage = "ebs"

# =====================================================================
# Neuron K8s stack (Trainium / Inferentia)
# =====================================================================
# Independent of install_gpu_stack / gpu_stack_mode — both can be on.
# Installs neuron-helm-chart (Neuron device plugin: aws.amazon.com/neuron +
# aws.amazon.com/neuroncore) and an EFA device plugin on workload-type=neuron
# nodes (reuses install_efa_device_plugin / efa_device_plugin_*).
# install_neuron_stack      = false
# neuron_helm_chart_version = "1.11.2"   # oci://public.ecr.aws/neuron/neuron-helm-chart
# Neuron scheduler extension + "my-scheduler" (pods set schedulerName:
# my-scheduler); only for partial-node multi-device contiguous placement.
# Exposure: adds ClusterIP kube-system/k8s-neuron-scheduler:12345 — plain
# HTTP, NO auth, pod network only; my-scheduler calls it for filter + bind and
# it binds pods with its own cluster-wide pods/binding RBAC. Restrict ingress
# to the my-scheduler pods with a NetworkPolicy (example in README).
# install_neuron_scheduler = false
# kube-scheduler tag for my-scheduler — REQUIRED (validation) when
# install_neuron_scheduler = true: the chart default (v1.31) is outside the
# 1.34/1.35 skew, so set an eks-distro tag whose minor matches k8s_version
# (e.g. "v1.35.9-eks-1-35-16" for 1.35, "v1.34.12-eks-1-34-25" for 1.34; list:
# gallery.ecr.aws/eks-distro/kubernetes/kube-scheduler).
# neuron_kube_scheduler_image_tag = ""
# Private mirrors (cn-* / isolated / air-gapped): chart + every image it pulls.
# "" = chart default (public.ecr.aws). Scheduler images only matter when
# install_neuron_scheduler = true. Also mirror neuron_monitor_image (with
# install_neuron_monitor) and, outside the EKS add-on ECR account map,
# efa_device_plugin_image. NOT mirrorable: neuron_monitor_service_monitor =
# true pulls bedag/raw 2.0.2 from https://bedag.github.io/helm-charts/
# (hardcoded) — keep it off in air-gapped regions.
# neuron_helm_chart_repository           = "oci://<account>.dkr.ecr.<region>.amazonaws.com.cn/neuron"
# neuron_device_plugin_image_repository  = ""
# neuron_device_plugin_image_tag         = ""
# neuron_scheduler_image_repository      = ""
# neuron_scheduler_image_tag             = ""
# neuron_kube_scheduler_image_repository = ""
#
# Neuron metrics (neuron-monitor) — opt-in, parity with dcgm-exporter (no
# metrics backend is installed). DaemonSet on workload-type=neuron nodes
# (inf1 excluded) + Service kube-system/neuron-monitor: ClusterIP :8000,
# plain HTTP, NO auth, pod network only (no hostNetwork / hostPort /
# NodePort / LB). Runs privileged (reads all /dev/neuron*). Needs
# install_neuron_stack = true.
# install_neuron_monitor = false
# neuron_monitor_image   = "public.ecr.aws/neuron/neuron-monitor:1.13.0"   # amd64; mirror for cn-*
# ServiceMonitor needs the Prometheus Operator CRDs (monitoring.coreos.com/v1)
# installed BEFORE apply. Labels let your Prometheus serviceMonitorSelector match.
# neuron_monitor_service_monitor        = false
# neuron_monitor_service_monitor_labels = { release = "kube-prometheus-stack" }
# BETA pod/namespace/container labels (--enable-k8s-info; RBAC get nodes/pods,
# pod-resources socket read-only). Without the Neuron scheduler extension
# (install_neuron_scheduler + schedulerName: my-scheduler) EVERY device/core on
# a node is attributed to the first Neuron pod there — correct only when one
# pod owns all of the node's Neuron devices.
# neuron_monitor_pod_attribution = false
# The Neuron Observer (chart observer.*) is intentionally NOT managed —
# hostNetwork :7001 with an unauthenticated API; see the README warning.

# =====================================================================
# Tagging
# =====================================================================
default_tags = {
  business = "middleware"
  resource = "eks"
}
